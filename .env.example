# Add these to .env; keep MYSQL_* temporarily if importing existing records.
# Database password stays server-side. Copy the Session pooler URI from Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
APP_ORIGIN=http://localhost:3000
OAUTH_PROVIDERS=google,github
SUPABASE_STORAGE_BUCKET=dog-photos
UPLOAD_STORAGE=supabase
PORT=3000
HOST=127.0.0.1
SEED_DEMO=false
UPLOAD_DIR=uploads
# Optional: path to Supabase's downloaded root certificate if your connection needs it.
# PGSSLROOTCERT=/absolute/path/to/prod-supabase.cer
# Tests use a separate local PostgreSQL database. Never point this at a live project.
# TEST_DATABASE_URL=postgresql://dog_discovery_test:LOCAL_PASSWORD@127.0.0.1:5433/postgres
